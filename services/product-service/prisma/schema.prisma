datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model Product {
  id              String   @id @default(uuid())
  shopId          String
  name            String
  image           String?
  images          String?  @db.Text // JSON string representation of string[]
  video           String?  // Video URL
  category        String
  categoryId      String?
  categoryRef     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand           String
  description     String
  price           Float    // Giá bán thực tế (VND)
  originalPrice   Float?   // Giá niêm yết trước giảm giá (VND)
  costPrice       Float?   @default(0) // Giá nhập / giá vốn hiện tại
  stock           Int
  sales           Int      @default(0)
  status          String   // "active" | "hidden"
  sku             String?
  variationsText  String?
  hasVariations   Boolean  @default(false)
  variationGroups String?  @db.Text // JSON string representation of VariationGroup[]
  variationRows   String?  @db.Text // JSON string representation of VariationRow[]
  weight          String?
  length          String?
  width           String?
  height          String?
  condition       String   @default("new") // "new" | "used"
  isPreOrder      Boolean  @default(false)
  preOrderDays    String?
  isViolated      Boolean  @default(false)
  violationReason String?
  reportsCount    Int      @default(0)
  priceHistories  PriceHistory[]
  costHistories   CostPriceHistory[]
  flashSaleItems  FlashSaleItem[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PriceHistory {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopId        String
  oldPrice      Float
  newPrice      Float
  changeType    String   @default("MANUAL") // "MANUAL" | "PROMOTION" | "IMPORT_ADJUSTMENT"
  changedBy     String   // Email hoặc tên người thực hiện
  changedByRole String   @default("SELLER") // "SELLER" | "ADMIN"
  reason        String?  // Lý do điều chỉnh giá
  createdAt     DateTime @default(now())
}

model CostPriceHistory {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopId      String
  costPrice   Float    // Giá nhập từng đơn vị (VND)
  quantity    Int      // Số lượng nhập theo hóa đơn/lô
  invoiceCode String?  // Mã hóa đơn / phiếu nhập kho
  supplier    String?  // Nhà cung cấp / Đối tác
  note        String?  // Ghi chú đợt nhập
  importedBy  String   // Người thực hiện nhập hàng
  importDate  DateTime @default(now()) // Ngày lập hóa đơn/nhập hàng
  createdAt   DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  productId String
  orderId   String?  // Liên kết với đơn hàng
  username  String
  rating    Int      // Từ 1 đến 5 sao
  comment   String
  variant   String   // Phân loại sản phẩm (ví dụ: Màu Đỏ, Size L)
  images    String?  @db.Text // JSON array các URL ảnh/video Cloudinary
  reply     String?  // Phản hồi của người bán (nếu có)
  createdAt DateTime @default(now())
}

model ProductLike {
  id        String   @id @default(uuid())
  productId String
  userId    String
  createdAt DateTime @default(now())

  @@unique([productId, userId])
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model FlashSale {
  id            String          @id @default(uuid())
  timeSlot      String          @unique
  productsCount Int             @default(0)
  status        String          @default("UPCOMING") // "RUNNING" | "UPCOMING" | "ENDED"
  items         FlashSaleItem[]
  createdAt     DateTime        @default(now())
}

model FlashSaleItem {
  id            String    @id @default(uuid())
  flashSaleId   String
  flashSale     FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopId        String
  flashPrice    Float
  originalPrice Float
  stockLimit    Int
  stockSold     Int       @default(0)
  status        String    @default("ACTIVE") // "ACTIVE" | "ENDED"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([flashSaleId, productId])
}

model AiModelKnowledge {
  id                String   @id @default(uuid())
  normalizedKey     String   // Chuỗi từ khóa chuẩn hóa (lowercase, không dấu)
  rawKeywords       String   // Từ khóa gốc người dùng nhập
  category          String   // Ngành hàng
  brand             String?  // Thương hiệu
  tone              String   // Phong cách viết
  features          String?  // Điểm nhấn tính năng
  suggestedTitle    String   // Tiêu đề sản phẩm
  suggestedCategory String   // Ngành hàng gợi ý
  suggestedBrand    String?  // Thương hiệu gợi ý
  seoKeywords       String   @db.Text // JSON string of string[]
  hashtags          String   @db.Text // JSON string of string[]
  description       String   @db.Text // Mô tả chi tiết
  trainingEpoch     Int      @default(1) // Số lần mô hình được train/cập nhật trên mẫu này
  hitCount          Int      @default(0) // Số lần mô hình nội bộ nhận diện và trả lời
  source            String   @default("gemini-2.5-flash") // Nguồn học
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([normalizedKey])
  @@index([category])
  @@index([tone])
}

model AiModerationKnowledge {
  id               String   @id @default(uuid())
  normalizedText   String   // Chuỗi chuẩn hóa (lowercase, bỏ dấu, chuẩn hóa khoảng trắng)
  rawText          String   // Nội dung gốc được kiểm duyệt
  checkType        String   @default("TITLE") // "TITLE" | "DESCRIPTION"
  isViolated       Boolean  @default(false)   // Có vi phạm chính sách không
  violationType    String?                    // "SAFE" | "NARCOTICS" | "WEAPONS" | "COUNTERFEIT" | "OBSCENE" | "DANGEROUS" | "RESTRICTED"
  confidence       Float    @default(1.0)     // Độ tin cậy (0.0 -> 1.0)
  reason           String?  @db.Text          // Giải thích ngữ cảnh chi tiết từ AI
  suggestion       String?  @db.Text          // Gợi ý điều chỉnh tiêu đề cho Người bán
  detectedKeywords String?  @db.Text          // Mảng từ khóa phát hiện (JSON string)
  hitCount         Int      @default(0)       // Số lần mô hình nội bộ tái sử dụng bài học này
  source           String   @default("gemini-2.5-flash") // "local-knowledge" | "gemini-2.5-flash" | "safe-rule"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([normalizedText])
  @@index([checkType])
  @@index([isViolated])
}

model AiSearchKnowledge {
  id                String   @id @default(uuid())
  searchType        String   // "SEMANTIC" | "VISUAL"
  queryKey          String   // Chuỗi tìm kiếm chuẩn hóa hoặc hash hình ảnh
  rawQuery          String   @db.Text // Chuỗi gốc hoặc image metadata/url
  detectedIntent    String?  @db.Text // Ý định tìm kiếm tóm tắt
  expandedKeywords  String   @db.Text // JSON string of string[] (các từ khóa mở rộng)
  suggestedCategory String?  // Ngành hàng gợi ý
  priceRangeMin     Float?   // Giá tối thiểu trích xuất từ câu
  priceRangeMax     Float?   // Giá tối đa trích xuất từ câu
  visualTags        String?  @db.Text // JSON string of attributes { productType, colors, style, gender, material }
  matchedProductIds String   @db.Text // JSON string of string[] các productId tương thích cao
  hitCount          Int      @default(0) // Số lần tái sử dụng tri thức
  source            String   @default("gemini-2.5-flash") // "local-cache" | "gemini-2.5-flash"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([searchType, queryKey])
}

model UserActivity {
  id        String   @id @default(uuid())
  userId    String
  action    String   // "VIEW" | "CART" | "LIKE" | "PURCHASE" | "SEARCH"
  productId String?
  category  String?
  metadata  String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
  @@index([category])
}
