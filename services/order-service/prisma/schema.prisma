datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model Order {
  id              String      @id @default(uuid())
  buyerId         String
  buyerEmail      String
  buyerName       String
  buyerPhone      String
  shippingAddress String
  totalAmount     Float
  shippingFee     Float
  paymentMethod   String      // "cod" | "zeropay" | "card" | "gpay" | "napas"
  status                String      @default("PENDING_PAYMENT") // "PENDING_PAYMENT" | "PROCESSING" | "SHIPPING" | "COMPLETED" | "CANCELLED"
  shopId                String?     // Shop sở hữu đơn hàng (1 Order = 1 Shop)
  checkoutGroupId       String?     // Nhóm các đơn cùng 1 lần checkout
  shopDiscountAmount    Float       @default(0)
  platformDiscountAmount Float      @default(0)
  shopVoucherCode       String?
  platformVoucherCode   String?
  appliedVoucherIds     String?     // JSON array các voucher IDs đã áp dụng
  ghnDistrictId         Int?
  ghnWardCode           String?
  ghnOrderCode          String?
  refundReason          String?
  refundDescription     String?
  refundEmail           String?
  refundProofImages     String?
  commissionRate        Float       @default(5) // Tỷ lệ chiết khấu bảo lưu tại thời điểm đặt hàng
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  shopId     String
  name       String
  image      String
  variant    String?
  price      Float
  quantity   Int
}
